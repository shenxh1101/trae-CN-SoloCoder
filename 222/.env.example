# AI会议发言总结工具 - 环境变量配置
# 复制此文件为 .env 并填入您的API Key
# cp .env.example .env

###########################################################################
#                          OpenAI 官方服务
###########################################################################
# 官网: https://platform.openai.com
# 模型: gpt-3.5-turbo, gpt-4, gpt-4-turbo, gpt-4o
###########################################################################

# OpenAI API Key (必填)
OPENAI_API_KEY=

# 模型名称 (默认: gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo

# 官方API地址 (无需修改)
OPENAI_BASE_URL=

###########################################################################
#                          DeepSeek 国内服务
###########################################################################
# 官网: https://www.deepseek.com
# 模型: deepseek-chat, deepseek-coder
# 价格: ¥1/百万token输入 tokens，性价比高
###########################################################################

# DeepSeek API Key
# OPENAI_API_KEY=sk-your-deepseek-key-here

# DeepSeek 模型名称
# OPENAI_MODEL=deepseek-chat

# DeepSeek API 地址 (必填！)
# OPENAI_BASE_URL=https://api.deepseek.com/v1

###########################################################################
#                          其他兼容服务
###########################################################################

# 智谱AI (GLM)
# OPENAI_API_KEY=
# OPENAI_MODEL=glm-4
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 通义千问
# OPENAI_API_KEY=
# OPENAI_MODEL=qwen-plus
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 豆包API
# OPENAI_API_KEY=
# OPENAI_MODEL=doubao-pro-32k
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

###########################################################################
#                          快速切换配置示例
###########################################################################

# ============== 【推荐:
# 1. 复制 .env.example → .env
# 2. 选择一个服务商，取消对应行的注释
# 3. 填入 API Key
# 4. 运行: python main.py -i example_meeting.txt
#
# DeepSeek 快速开始:
# OPENAI_API_KEY=sk-xxxxxxxxxx
# OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com/v1

###########################################################################
#                          常见问题
###########################################################################
# Q: 如何获取 API Key?
# A: 注册对应服务商官网，在控制台/API密钥页面生成
#
# Q: 没有 API Key 怎么办?
# A: 使用 --no-llm 参数，使用关键词总结
#
# Q: 如何验证配置正确?
# A: 运行: python main.py -i example_meeting.txt -v
