{
  "name": "fittrackpro-functions",
  "version": "1.0.0",
  "description": "FitTrack Pro Firebase Cloud Functions",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "@google-cloud/vision": "^4.0.2",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "nodemailer": "^6.9.7",
    "stripe": "^14.5.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "@types/node": "^20.8.10",
    "@types/cors": "^2.8.16",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
