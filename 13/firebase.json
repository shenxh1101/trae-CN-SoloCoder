{
  "react-native": {
    "messaging_android_notification_channel_id": "fittrack_channel",
    "messaging_ios_auto_register_for_remote_messages": true,
    "analytics_auto_collection_enabled": true,
    "perf_auto_collection_enabled": true,
    "crashlytics_disable_auto_disable": true,
    "crashlytics_debug_enabled": false
  },
  "functions": {
    "source": "functions",
    "predeploy": "npm --prefix functions run build",
    "runtime": "nodejs18"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    }
  }
}
