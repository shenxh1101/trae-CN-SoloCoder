    </Paragraph>
    <Paragraph Type="Character">
      <Alignment Justify="Center" />
      <Text Font="Courier Final Draft" Size="12">小明</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Alignment Justify="Left" />
      <Text Font="Courier Final Draft" Size="12">(紧张)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Alignment Justify="Left" />
      <Text Font="Courier Final Draft" Size="12">你好...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Alignment Justify="Center" />
