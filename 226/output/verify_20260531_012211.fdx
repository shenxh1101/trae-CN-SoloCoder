    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Alignment Justify="Left" />
      <Text Font="Courier Final Draft" Size="12">(微笑)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Alignment Justify="Left" />
      <Text Font="Courier Final Draft" Size="12">你好呀！</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Alignment Justify="Center" />
      <Text Font="Courier Final Draft" Size="12">小明</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Alignment Justify="Left" />
      <Text Font="Courier Final Draft" Size="12">(放松)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Alignment Justify="Left" />
      <Text Font="Courier Final Draft" Size="12">今天天气不错。</Text>
