# AI API 配置
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo

# 本地模型配置（可选）
LOCAL_MODEL_URL=http://localhost:11434/api/generate
LOCAL_MODEL_NAME=llama2

# TTS 配置
TTS_ENGINE=pyttsx3
TTS_RATE=150
TTS_VOLUME=0.8

# 评分阈值
EXCELLENT_SCORE=85
GOOD_SCORE=70
PASS_SCORE=60
